  criado_em         DateTime @default(now())
  revogado_em       DateTime?
  revogado_por_id   String?
  motivo_revogacao  String? @db.VarChar(1000)
  oficial           oficial @relation(fields: [oficial_id, igreja_id], references: [id, igreja_id], onDelete: Restrict, onUpdate: NoAction)
  identidade        identidade_pastoral @relation(fields: [identidade_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  criado_por        usuarios @relation("ReferenciaPastoralCriador", fields: [criado_por_id, igreja_id], references: [id, igreja_id], onDelete: Restrict, onUpdate: NoAction)
  revogado_por      usuarios? @relation("ReferenciaPastoralRevogador", fields: [revogado_por_id, igreja_id], references: [id, igreja_id], onDelete: Restrict, onUpdate: NoAction)
  convites_origem   convite_identidade_pastoral[] @relation("ConvitePastoralOrigem")
  convites_destino  convite_identidade_pastoral[] @relation("ConvitePastoralDestino")

  @@unique([id, igreja_id, identidade_id])
