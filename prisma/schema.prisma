  convites    convite_identidade_pastoral[]
}
model referencia_identidade_pastoral {
  id                String @id @default(uuid())
  igreja_id         String
  oficial_id        String
  identidade_id     String
  autoridade        String @db.VarChar(255)
  evidencia         String @db.VarChar(1000)
