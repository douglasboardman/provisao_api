model convite_identidade_pastoral {
  id                 String @id @default(uuid())
  identidade_id      String
  origem_igreja_id   String
  destino_igreja_id  String
  origem_referencia_id String
  destino_referencia_id String?
  criado_por_id      String
  autoridade         String? @db.VarChar(255)
  evidencia          String? @db.VarChar(1000)
  token_hash         String @unique @db.Char(64)
  criado_em          DateTime @default(now())
  expira_em          DateTime
  consumido_em       DateTime?
  revogado_em        DateTime?
  identidade         identidade_pastoral @relation(fields: [identidade_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  origem_referencia  referencia_identidade_pastoral @relation("ConvitePastoralOrigem", fields: [origem_referencia_id, origem_igreja_id, identidade_id], references: [id, igreja_id, identidade_id], onDelete: Restrict, onUpdate: NoAction)
  destino_referencia referencia_identidade_pastoral? @relation("ConvitePastoralDestino", fields: [destino_referencia_id, destino_igreja_id, identidade_id], references: [id, igreja_id, identidade_id], onDelete: Restrict, onUpdate: NoAction)
  criado_por         usuarios @relation(fields: [criado_por_id, origem_igreja_id], references: [id, igreja_id], onDelete: Restrict, onUpdate: NoAction)
  igreja_destino     igreja @relation("IgrejaDestinoIdentidade", fields: [destino_igreja_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([origem_igreja_id, origem_referencia_id])
}

