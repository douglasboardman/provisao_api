model oficial {
  presidencias_assembleia mesa_assembleia[]
  id                String @id @default(uuid())
  igreja_id         String
  pessoa_id         String
  tipo              oficio_tipo
  ativo             Boolean @default(true)
  criado_em         DateTime @default(now())
  pessoa            pessoas @relation(fields: [pessoa_id, igreja_id], references: [id, igreja_id], onDelete: Restrict, onUpdate: NoAction)
  mandatos          mandato_oficial[]
  eventos           evento_oficial[]
  vinculos_pastorais vinculo_pastoral[]
  insercoes_retroativas insercao_retroativa_oficial[]
  registros_historicos registro_historico_oficial[]
  referencias_identidade referencia_identidade_pastoral[]
  presidencias_conselho presidencia_conselho[]

  @@unique([id, igreja_id])
  @@unique([igreja_id, pessoa_id, tipo])
  // A migração oficial_ativo_por_pessoa garante a unicidade de (igreja_id, pessoa_id) onde ativo = true.
}

model mandato_oficial {
  orgao_id          String?
  versao_orgao_id   String?
  versao_orgao      versao_orgao? @relation(fields: [versao_orgao_id, igreja_id, orgao_id], references: [id, igreja_id, orgao_id], onDelete: Restrict, onUpdate: Restrict, map: "mandato_versao_orgao_fkey")
  chave_registro    String?
  hash_registro     String?
  @@unique([igreja_id, chave_registro])
  referencias_ata referencia_ata_oficial[]
  id                String @id @default(uuid())
  igreja_id         String
  oficial_id        String
  data_eleicao      DateTime @db.Date
  data_posse        DateTime @db.Date
  termino_previsto  DateTime @db.Date
  termino_efetivo   DateTime? @db.Date
  motivo_encerramento String?
  autoridade        String
  evidencia         String
  avaliacao_eleicao Json
  conferencia_id   String? @unique
  conferencia      conferencia_eleicao_oficial? @relation(fields: [conferencia_id, igreja_id], references: [id, igreja_id], onDelete: Restrict, onUpdate: NoAction)
  indicacao_id      String? @unique
  indicacao         indicacao_eleicao_oficial? @relation(fields: [indicacao_id, igreja_id], references: [id, igreja_id], onDelete: Restrict, onUpdate: NoAction)
  criado_em         DateTime @default(now())
  oficial           oficial @relation(fields: [oficial_id, igreja_id], references: [id, igreja_id], onDelete: Restrict, onUpdate: NoAction)
  revisoes_pendentes revisao_eleitoral_item[]
  alertas           alerta_mandato[]

  @@unique([id, igreja_id])
  @@unique([conferencia_id, igreja_id])
  @@unique([indicacao_id, igreja_id])
  @@index([igreja_id, oficial_id, data_posse])
}

model indicacao_eleicao_oficial {
  id                    String @id @default(uuid())
  igreja_id             String
  pessoa_id             String
  oficio                oficio_tipo
  ata_conselho_versao_id String
  data_assembleia       DateTime @db.Date
  registrado_por_id     String
  criado_em             DateTime @default(now())
  pessoa                pessoas @relation(fields: [pessoa_id, igreja_id], references: [id, igreja_id], onDelete: Restrict, onUpdate: NoAction)
  ata_conselho          documento_versao @relation(fields: [ata_conselho_versao_id, igreja_id], references: [id, igreja_id], onDelete: Restrict, onUpdate: NoAction)
  registrado_por        usuarios @relation(fields: [registrado_por_id, igreja_id], references: [id, igreja_id], onDelete: Restrict, onUpdate: NoAction)
  mandato               mandato_oficial?

  @@unique([id, igreja_id])
  @@unique([igreja_id, pessoa_id, oficio, data_assembleia], map: "indicacao_eleicao_pessoa_oficio_assembleia_key")
  @@index([igreja_id, data_assembleia])
}

model evento_oficial {
  id                String @id @default(uuid())
  igreja_id         String
  oficial_id        String
  tipo              oficial_evento_tipo
  data_efeito       DateTime @db.Date
  ordem             Int
  autoridade        String
  evidencia         String
  observacoes       String?
  evento_restaurado_id String? @unique
  criado_em         DateTime @default(now())
  oficial           oficial @relation(fields: [oficial_id, igreja_id], references: [id, igreja_id], onDelete: Restrict, onUpdate: NoAction)
