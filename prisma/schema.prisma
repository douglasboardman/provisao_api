generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model origem_campo_secretaria {
  chave String @id
  cadastro String
  propriedade String
  transformacao String?
  campos campo_secretaria[]
}

model campo_secretaria {
  mapeamento origem_campo_secretaria @relation(fields: [origem], references: [chave], onDelete: NoAction, onUpdate: NoAction)
  id         String @id @default(uuid())
  igreja_id  String
  igreja     igreja @relation(fields: [igreja_id], references: [id], onDelete: Cascade)
  nome       String @db.VarChar(120)
  codigo     String?
  tipo       String
  multiplo   Boolean
  origem     String
  ativo      Boolean @default(true)
  revisao    Int @default(1)

  @@unique([igreja_id, codigo])
  @@index([igreja_id, ativo])
}

model igreja {
  liberacoes_servico liberacao_servico[]
  modelos_atribuicoes modelo_atribuicoes[]
  locais_reuniao local_reuniao[]
  campos_secretaria campo_secretaria[]
  contextos_secretaria contexto_secretaria[]
  id                 String              @id @default(uuid())
  cnpj               String?             @unique(map: "igreja_cnpj_UNIQUE") @db.VarChar(14)
  nome               String              @db.VarChar(255)
  url_logo           String?             @db.VarChar(255)
  congregacao        Boolean             @default(false)
  vinculada_a        String?
  cep                String?             @db.VarChar(8)
  logradouro         String?             @db.VarChar(255)
  numero             String?             @db.VarChar(20)
  complemento        String?             @db.VarChar(100)
  bairro             String?             @db.VarChar(100)
  cidade             String?             @db.VarChar(100)
  estado             estados_brasil?
  ativa              Boolean             @default(true)
  mfa_obrigatorio    Boolean             @default(false)
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt

  // Autorrelacionamento: Uma congregação pertence a uma matriz
  igreja_matriz      igreja?             @relation("MatrizCongregacoes", fields: [vinculada_a], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "igreja_matriz_fk")
  congregacoes       igreja[]            @relation("MatrizCongregacoes")

  // Relacionamentos globais (Multi-tenant)
  acoes              acoes[]
  contas             contas[]
  despesas           despesas[]
  receitas           receitas[]
  grupos_familiares  grupos_familiares[]
  lancamentos        lancamentos[]
  logs_atividades    logs_atividades[]
  pessoas            pessoas[]
  profissoes         profissoes[]
  parametros_membresia parametro_membresia_igreja[]
  cat_despesa        cat_despesa[]
  cat_receita        cat_receita[]
  usuarios           usuarios[]
  eventos_membresia  eventos_membresia[]
  convites_identidade_destino convite_identidade_pastoral[] @relation("IgrejaDestinoIdentidade")
  politica_alerta_oficiais politica_alerta_oficiais?
  execucao_alerta_oficiais execucao_alerta_oficiais?
  politicas_eleicao  politica_eleicao_oficial[]
  solicitacoes_acesso solicitacao_acesso[]
  orgaos orgao_interno[]
  configuracao_fuso configuracao_fuso_igreja?

  @@index([vinculada_a], map: "igreja_vinculada_a_idx")
}

model acoes {
  autorizacoes_documentais autorizacao_financeira_documental[]
  id                    String   @id @default(uuid())
  igreja_id             String
  nome                  String   @db.VarChar(255)
  descricao_detalhada   String?  @db.Text
  cor_hex               String?  @db.VarChar(7)
  responsavel_pessoa_id String
  conta_id              String
  data_inicio           DateTime @db.Date
  data_fim              DateTime? @db.Date
  orcamento_receita     Decimal  @default(0.00) @db.Decimal(10, 2)
  orcamento_despesa     Decimal  @default(0.00) @db.Decimal(10, 2)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  
  igreja                igreja   @relation(fields: [igreja_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "acoes_igreja_fk")
  pessoas               pessoas  @relation(fields: [responsavel_pessoa_id], references: [id], onUpdate: NoAction, map: "acoes_ibfk_1")
  contas                contas   @relation(fields: [conta_id], references: [id], onUpdate: NoAction, map: "acoes_ibfk_2")
  lancamentos           lancamentos[]

  @@index([igreja_id], map: "acoes_igreja_id")
  @@index([responsavel_pessoa_id], map: "acoes_responsavel_pessoa_id")
  @@index([conta_id], map: "acoes_conta_id")
  @@unique([id, igreja_id])
}

model contas {
  autorizacoes_documentais autorizacao_financeira_documental[]
  id            String        @id @default(uuid())
  igreja_id     String
  descricao     String        @db.VarChar(100)
  banco         String?       @db.VarChar(100)
  tipo_conta    tipo_conta
  num_conta     String?       @db.VarChar(15)
  agencia       String?       @db.VarChar(7)
  saldo_inicial Decimal       @default(0.00) @db.Decimal(10, 2)
  cor_hex       String?       @db.VarChar(7)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  
  igreja        igreja        @relation(fields: [igreja_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contas_igreja_fk")
  lancamentos   lancamentos[]
  acoes         acoes[]

  @@index([igreja_id], map: "contas_igreja_id")
  @@unique([id, igreja_id])
}

model despesas {
  id                 Int           @id @default(autoincrement())
  igreja_id          String
  nome               String        @db.VarChar(100)
  cat_despesa_id     Int
  requer_pessoa      Boolean       @default(false)
  requer_acao        Boolean       @default(false)
  requer_conta       Boolean       @default(false)
  requer_comprovante Boolean       @default(false)
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt
  
  igreja             igreja        @relation(fields: [igreja_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "despesas_igreja_fk")
  cat_despesa        cat_despesa   @relation(fields: [cat_despesa_id], references: [id], onUpdate: NoAction, map: "despesas_ibfk_1")
  lancamentos        lancamentos[]

  // O nome deve ser único apenas DENTRO da mesma igreja
  @@unique([igreja_id, nome], map: "despesas_igreja_nome_UNIQUE")
  @@index([igreja_id], map: "despesas_igreja_id")
  @@index([cat_despesa_id], map: "despesas_cat_despesa_id")
}

model receitas {
  id                 Int           @id @default(autoincrement())
  igreja_id          String
  nome               String        @db.VarChar(100)
  cat_receita_id     Int
  requer_pessoa      Boolean       @default(false)
  requer_acao        Boolean       @default(false)
  requer_conta       Boolean       @default(false)
  requer_comprovante Boolean       @default(false)
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt
  
  igreja             igreja        @relation(fields: [igreja_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "receitas_igreja_fk")
  cat_receita        cat_receita   @relation(fields: [cat_receita_id], references: [id], onUpdate: NoAction, map: "receitas_ibfk_1")
  lancamentos        lancamentos[]

  // O nome deve ser único apenas DENTRO da mesma igreja
  @@unique([igreja_id, nome], map: "receitas_igreja_nome_UNIQUE")
  @@index([igreja_id], map: "receitas_igreja_id")
  @@index([cat_receita_id], map: "receitas_cat_receita_id")
}

model grupos_familiares {
  id           String    @id @default(uuid())
  igreja_id    String
  nome_familia String    @db.VarChar(255)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  
  igreja       igreja    @relation(fields: [igreja_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "grupos_familiares_igreja_fk")
  pessoas      pessoas[]

  @@index([igreja_id], map: "grupos_familiares_igreja_id")
}

model lancamentos {
  id                    String                     @id @default(uuid())
  igreja_id             String
  data_transacao        DateTime                   @db.Date
  valor                 Decimal                    @db.Decimal(10, 2)
  tipo_transacao        lancamentos_tipo_transacao
  conta_id              String
  acao_id               String?
  receita_id            Int?
  despesa_id            Int?
  pessoa_id             String?
  observacao            String?                    @db.Text
  comprovante_url       String?                    @db.VarChar(255)
  usuario_id            String
  created_at            DateTime                   @default(now())
  updated_at            DateTime                   @updatedAt
  
  igreja                igreja                     @relation(fields: [igreja_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "lancamentos_igreja_fk")
  contas                contas                     @relation(fields: [conta_id], references: [id], onUpdate: NoAction, map: "lancamentos_ibfk_1")
  acoes                 acoes?                     @relation(fields: [acao_id], references: [id], onUpdate: NoAction, map: "lancamentos_ibfk_2")
  receitas              receitas?                  @relation(fields: [receita_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "lancamentos_ibfk_3")
  despesas              despesas?                  @relation(fields: [despesa_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "lancamentos_ibfk_4")
  pessoas               pessoas?                   @relation(fields: [pessoa_id], references: [id], onUpdate: NoAction, map: "lancamentos_ibfk_5")
  usuarios              usuarios                   @relation(fields: [usuario_id], references: [id], onUpdate: NoAction, map: "lancamentos_ibfk_6")

  @@index([igreja_id], map: "lancamentos_igreja_id")
  @@index([conta_id], map: "lancamentos_conta_id")
  @@index([despesa_id], map: "lancamentos_despesa_id")
  @@index([receita_id], map: "lancamentos_receita_id")
  @@index([acao_id], map: "lancamentos_acao_id")
  @@index([pessoa_id], map: "lancamentos_pessoa_id")
  @@index([usuario_id], map: "lancamentos_usuario_id")
}

model logs_atividades {
  id             BigInt               @id @default(autoincrement())
  igreja_id      String
  usuario_id     String
  ip_address     String?              @db.VarChar(45)
  acao           logs_atividades_acao
  tabela_afetada String               @db.VarChar(100)
  registro_id    String?              // Mudado para String para comportar UUIDs
  dados_antigos  Json?
  dados_novos    Json?
  created_at     DateTime             @default(now())
  
  igreja         igreja               @relation(fields: [igreja_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "logs_igreja_fk")
  usuarios       usuarios             @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "logs_atividades_ibfk_1")

  @@index([igreja_id], map: "logs_atividades_igreja_id")
  @@index([usuario_id], map: "logs_atividades_usuario_id")
}

model pessoas {
  secretarias_assembleia mesa_assembleia[]
  itens_pauta_propostos item_pauta_reuniao[]
  competencias_secretaria competencia_secretaria[]
  participantes_reuniao participante_reuniao[]
  arrolamentos_documento arrolado_documento[]
  id                 String               @id @default(uuid())
  igreja_id          String
  nome_completo      String               @db.VarChar(255)
  url_foto           String?              @db.VarChar(255)
  cpf                String?              @db.VarChar(11)
  data_nascimento    DateTime             @db.Date
  sexo               pessoas_sexo
  estado_civil       pessoas_estado_civil?
  email              String?              @db.VarChar(255)
  telefone_celular   String?              @db.VarChar(15)
  cep                String?              @db.VarChar(8)
  logradouro         String?              @db.VarChar(255)
  numero             String?              @db.VarChar(20)
  complemento        String?              @db.VarChar(100)
  bairro             String?              @db.VarChar(100)
  cidade             String?              @db.VarChar(100)
  estado             estados_brasil?      // Atualizado para usar o Enum
  grupo_familiar_id  String?
  tratamento_id      Int?
  profissao_id       String?
  conjuge_id         String?
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  
  igreja             igreja               @relation(fields: [igreja_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "pessoas_igreja_fk")
  lancamentos        lancamentos[]
  acoes              acoes[]
  grupos_familiares  grupos_familiares?   @relation(fields: [grupo_familiar_id], references: [id], onUpdate: NoAction, map: "pessoas_ibfk_1")
  tratamentos        tratamentos?         @relation(fields: [tratamento_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "pessoas_tratamento_fk")
  profissao          profissoes?          @relation(fields: [profissao_id, igreja_id], references: [id, igreja_id], onDelete: NoAction, onUpdate: NoAction, map: "pessoas_profissao_igreja_fkey")
  conjuge            pessoas?             @relation("PessoaConjuge", fields: [conjuge_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "pessoas_conjuge_fk")
  conjuge_de         pessoas[]            @relation("PessoaConjuge")
  eventos_membresia  eventos_membresia[]
  usuarios           usuarios[]
  competencias_acesso competencia_acesso[]
  oficiais           oficial[]
  conferencias_eleicao conferencia_eleicao_oficial[]
  indicacoes_eleicao indicacao_eleicao_oficial[]
  decisoes_eleitorais decisao_revisao_eleitoral[]
  decisoes_orgaos decisao_revisao_orgao[]
  correcoes_conteudo correcao_conteudo_membresia[]
  insercoes_retroativas insercao_retroativa_membresia[]
  ordenacoes_membresia ordenacao_membresia[]
  participacoes_orgao membro_orgao[]
  ocupacoes_orgao ocupacao_cargo[]
  orgaos_instituidos orgao_interno[] @relation("InstituidorOrgao")
  conducoes_reuniao conducao_reuniao_orgao[]
  competencias_unidades competencia_unidades[]

  @@unique([id, igreja_id])
  @@index([igreja_id, profissao_id])
  // Um CPF ou Email só deve ser único DENTRO da mesma igreja
  @@unique([igreja_id, cpf], map: "pessoas_igreja_cpf_UNIQUE")
  @@unique([igreja_id, email], map: "pessoas_igreja_email_UNIQUE")
  @@index([igreja_id], map: "pessoas_igreja_id")
  @@index([grupo_familiar_id], map: "pessoas_grupo_familiar_id")
  @@index([tratamento_id], map: "pessoas_tratamento_id")
  @@index([conjuge_id], map: "pessoas_conjuge_id")
}

model cat_despesa {
  id                  Int                   @id @default(autoincrement())
  igreja_id           String
  nome                String                @db.VarChar(100)
  cor_hex             String?               @db.VarChar(7)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  
  igreja              igreja                @relation(fields: [igreja_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cat_despesa_igreja_fk")
  despesas            despesas[]

  @@unique([igreja_id, nome], map: "cat_despesa_igreja_nome_UNIQUE")
  @@index([igreja_id], map: "cat_despesa_igreja_id")
}

model cat_receita {
  id                  Int                   @id @default(autoincrement())
  igreja_id           String
  nome                String                @db.VarChar(100)
  cor_hex             String?               @db.VarChar(7)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  
  igreja              igreja                @relation(fields: [igreja_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cat_receita_igreja_fk")
  receitas            receitas[]

  @@unique([igreja_id, nome], map: "cat_receita_igreja_nome_UNIQUE")
  @@index([igreja_id], map: "cat_receita_igreja_id")
}

model usuarios {
  propostas_configuracao proposta_versao_orgao[]
  conta_atuacao Boolean @default(false)
  geracao_vinculo Int @default(0)
  atribuicoes_servico atribuicao_servico[]
  concessoes_modelo_atuacao concessao_modelo_atuacao[]
  concessoes_assembleia acesso_assembleia[]
  folhas_extraidas folha_presenca_assembleia[]
  mesas_registradas mesa_assembleia[]
  referencias_ata_inst referencia_ata_institucional[]
  autorizacoes_documentais autorizacao_financeira_documental[]
  referencias_ata_oficial referencia_ata_oficial[]
  referencias_ata_membresia referencia_ata_membresia[]
  expedicoes_documento expedicao_documento[]
  convites_assinatura convite_assinatura[]
  conferencias_fisicas conferencia_fisica[]
  eventos_livro evento_livro[]

  trabalhos_renderizacao trabalho_renderizacao[]
  competencias_secretaria competencia_secretaria[] @relation("TitularSecretaria")
  concessoes_secretaria competencia_secretaria[] @relation("ConcedenteSecretaria")
  comandos_secretaria comando_secretaria[]
  id                String            @id @default(uuid())
  igreja_id         String
  nome_usuario      String            @db.VarChar(255)
  email_login       String            @db.VarChar(255)
  url_imagem_perfil String?           @db.VarChar(255)
  senha_hash        String            @db.VarChar(255)
  auth_version      Int               @default(0)
  mfa_reinscricao_obrigatoria Boolean @default(false)
  pessoa_id         String?
  perfil            usuarios_perfil
  ativo             Boolean           @default(true)
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  
  igreja            igreja            @relation(fields: [igreja_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "usuarios_igreja_fk")
  lancamentos       lancamentos[]
  logs_atividades   logs_atividades[]
  pessoa            pessoas?          @relation(fields: [pessoa_id, igreja_id], references: [id, igreja_id], onDelete: Restrict, onUpdate: Restrict, map: "usuarios_pessoa_igreja_fkey")
  tokens_senha      token_senha[]
  sessoes           sessoes[]
  arquivos_privados arquivo_privado[]
  mfa_emergenciais  mfa_recuperacao_emergencial[]
  mfa_credencial    mfa_credencial?
  mfa_recuperacao   mfa_recuperacao[]
  mfa_pendente      mfa_recuperacao_pendente?
  solicitacoes_conta solicitacao_acesso[] @relation("SolicitacaoConta")
  solicitacoes_analisadas solicitacao_acesso[] @relation("SolicitacaoAnalista")
  competencias_recebidas competencia_acesso[] @relation("CompetenciaTitular")
  orgaos_criados orgao_interno[] @relation("CriadorOrgao")
  atos_orgao ato_orgao[]
  competencias_unidades competencia_unidades[] @relation("GestorUnidades")
  competencias_unidades_registradas competencia_unidades[] @relation("RegistradorCompetenciaUnidades")
  presidencias_conselho_registradas presidencia_conselho[]
  politicas_unidade_registradas politica_unidade[]
  requisicoes_institucionais requisicao_institucional[]
  competencias_concedidas competencia_acesso[] @relation("CompetenciaConcedente")
  competencias_revogadas competencia_acesso[] @relation("CompetenciaRevogador")
  politicas_eleicao_criadas politica_eleicao_oficial[]
  conferencias_eleicao_criadas conferencia_eleicao_oficial[]
  indicacoes_eleicao_registradas indicacao_eleicao_oficial[]
  acessos_sensiveis_recebidos acesso_eventos_sensiveis[] @relation("AcessoSensivelTitular")
  acessos_sensiveis_concedidos acesso_eventos_sensiveis[] @relation("AcessoSensivelConcedente")
  acessos_sensiveis_revogados acesso_eventos_sensiveis[] @relation("AcessoSensivelRevogador")
  insercoes_retroativas_oficiais insercao_retroativa_oficial[]
  registros_historicos_oficiais registro_historico_oficial[]
  correcoes_membresia correcao_data_membresia[]
  decisoes_eleitorais decisao_revisao_eleitoral[]
  decisoes_orgaos decisao_revisao_orgao[]
  revisoes_eleitorais_concluidas revisao_eleitoral_item[] @relation("RevisaoEleitoralResponsavel")
  correcoes_conteudo correcao_conteudo_membresia[]
  insercoes_retroativas insercao_retroativa_membresia[]
  ordenacoes_membresia ordenacao_membresia[]
  referencias_pastorais_criadas referencia_identidade_pastoral[] @relation("ReferenciaPastoralCriador")
  referencias_pastorais_revogadas referencia_identidade_pastoral[] @relation("ReferenciaPastoralRevogador")
  convites_pastorais_criados convite_identidade_pastoral[]
  politica_alerta_alterada politica_alerta_oficiais[]
  alertas_recebidos alerta_mandato[] @relation("AlertaDestinatario")
  inscricoes_alerta inscricao_alerta_oficial[] @relation("InscricaoDestinatario")
  inscricoes_alerta_criadas inscricao_alerta_oficial[] @relation("InscricaoCriador")

  @@unique([id, igreja_id])
  @@index([pessoa_id, igreja_id])
  @@unique([igreja_id, email_login], map: "usuarios_igreja_email_UNIQUE")
  @@index([igreja_id], map: "usuarios_igreja_id")
}

model mfa_recuperacao_emergencial {
  id                  String   @id @default(uuid())
  igreja_id           String
  usuario_id          String
  nonce_hash          String   @unique
  chave_fingerprint   String
  autoridade_externa  String   @db.VarChar(120)
  motivo              String   @db.VarChar(500)
  created_at          DateTime @default(now())
  usuario             usuarios @relation(fields: [usuario_id, igreja_id], references: [id, igreja_id], onDelete: Restrict, onUpdate: Restrict, map: "mfa_emergencial_usuario_igreja_fkey")

  @@index([igreja_id, usuario_id], map: "mfa_recuperacao_emergencial_igreja_usuario_idx")
}

model mfa_credencial {
  usuario_id      String   @id
  segredo_cifrado String
  estado          String   @default("PENDENTE")
  expira_em       DateTime?
  ultimo_passo    Int?
  falhas          Int      @default(0)
  bloqueado_ate   DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  usuario         usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade, map: "mfa_credencial_usuario_fkey")
}

model mfa_recuperacao {
  id           String    @id @default(uuid())
  usuario_id   String
  hash         String
  consumido_em DateTime?
  reserva_sessao_id String? @unique
  reserva_ate DateTime?
