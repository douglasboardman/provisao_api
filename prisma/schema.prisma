  @@index([versao_id, criado_em])
}
model ato_acesso_assembleia {
  id String @id @default(uuid())
  acesso_id String
  operacao String
  revisao Int
  registrado_em DateTime @default(now())
  acesso acesso_assembleia @relation(fields: [acesso_id], references: [id], onDelete: Restrict)
  @@unique([acesso_id, operacao, revisao])
}

model liberacao_servico {
  igreja_id String
  acao      String
  estado    String
  revisao   Int
  igreja    igreja @relation(fields: [igreja_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([igreja_id, acao])
}

model atribuicao_servico {
  id String @id @default(uuid())
  igreja_id String
  usuario_id String
  pessoa_id String
  geracao_vinculo Int
  acao String
  inicio DateTime @db.Timestamptz(3)
  fim DateTime? @db.Timestamptz(3)
  revogado_em DateTime? @db.Timestamptz(3)
  concessao_modelo_id String?
  concessao_modelo concessao_modelo_atuacao? @relation(fields: [concessao_modelo_id, igreja_id], references: [id, igreja_id], onDelete: Restrict, onUpdate: Restrict)
  usuario usuarios @relation(fields: [usuario_id, igreja_id], references: [id, igreja_id], onDelete: Restrict, onUpdate: Restrict)
  @@index([igreja_id, usuario_id])
  @@index([concessao_modelo_id])
}

model evento_autorizacao {
  id String @id @default(uuid())
  igreja_id String
  operador_id String
  operador_pessoa_id String?
  destinatario_id String?
  pessoa_id String?
  acao String
  recurso_id String?
  fundamento String
  dados Json
  instante DateTime @default(now()) @db.Timestamptz(3)
  @@index([igreja_id, instante])
}

model modelo_atribuicoes {
  id                String   @id @default(uuid())
  igreja_id         String
  nome              String
  nome_normalizado  String
  acoes             String[]
  cargo_id          String?
  oficio            oficio_tipo?
  igreja            igreja   @relation(fields: [igreja_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cargo             cargo_orgao? @relation(fields: [cargo_id, igreja_id], references: [id, igreja_id], onDelete: Restrict, onUpdate: Restrict)
  concessoes        concessao_modelo_atuacao[]

  @@unique([id, igreja_id])
  @@unique([igreja_id, nome_normalizado])
}

model concessao_modelo_atuacao {
  id               String @id @default(uuid())
  igreja_id        String
  modelo_id        String
  usuario_id       String
  pessoa_id        String
  geracao_vinculo  Int
  qualificacao_id  String
  inicio           DateTime @db.Timestamptz(3)
  fim              DateTime? @db.Timestamptz(3)
  revogado_em      DateTime? @db.Timestamptz(3)
  modelo           modelo_atribuicoes @relation(fields: [modelo_id, igreja_id], references: [id, igreja_id], onDelete: Restrict, onUpdate: Restrict)
  usuario          usuarios @relation(fields: [usuario_id, igreja_id], references: [id, igreja_id], onDelete: Restrict, onUpdate: Restrict)
  atribuicoes      atribuicao_servico[]

  @@unique([id, igreja_id])
  @@index([igreja_id, modelo_id, usuario_id])
}
