  evento_restaurado evento_oficial? @relation("RestauracaoEvento", fields: [evento_restaurado_id, igreja_id, oficial_id], references: [id, igreja_id, oficial_id], onDelete: Restrict, onUpdate: NoAction)
  restauracao       evento_oficial? @relation("RestauracaoEvento")

  @@unique([id, igreja_id, oficial_id])
  @@unique([evento_restaurado_id, igreja_id, oficial_id])
  @@unique([oficial_id, data_efeito, ordem])
  @@index([igreja_id, oficial_id, data_efeito])
}

model vinculo_pastoral {
